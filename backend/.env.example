# Company Intelligence Platform - Backend Environment Variables
# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Project & API
PROJECT_NAME="Project Manager"
API_V1_PREFIX="/api/v1"

# Security (REQUIRED) — the server refuses to start without a strong, unique key.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""
# Password for the built-in admin@company.com account. Leave empty to disable its password login.
ADMIN_PASSWORD=""

# Database
# Local SQLite:
DATABASE_URL="sqlite+aiosqlite:///./company_intel.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://USER:PASSWORD@HOST:5432/company_intel"

# Public URL of the web app (used for links in alert emails)
APP_BASE_URL="https://your-domain.example"
# Allowed browser origins (JSON list)
# CORS_ORIGINS=["https://your-domain.example"]

# Default alert recipient
DEFAULT_ALERT_EMAIL="admin@your-company.example"
DEFAULT_ALERT_NAME="Administrator"

# Redmine Integration
REDMINE_URL="https://redmine.yourcompany.com"
REDMINE_API_KEY="your-redmine-api-key-here"
REDMINE_SYNC_INTERVAL_MINUTES=1

# SMTP Email Alerting — URGENT & CRITICAL alerts are emailed to the administrator
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Project Manager Alerts"
EMAIL_ALERT_SEVERITIES="URGENT,CRITICAL"

# OpenRouter AI Integration (Grounded Assistant)
OPENROUTER_API_KEY=""
OPENROUTER_DEFAULT_MODEL=""
OPENROUTER_FALLBACK_MODEL=""

# Google OAuth 2.0 (Sign in with Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
