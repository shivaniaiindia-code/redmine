# Company Intelligence Platform - Backend Environment Variables

# Project & API
PROJECT_NAME="Company Intelligence Platform"
API_V1_PREFIX="/api/v1"
SECRET_KEY="cip-super-secret-production-key-change-in-env-2026-xyz"

# Database Configuration:
# For local zero-setup dev:
DATABASE_URL="sqlite+aiosqlite:///./company_intel.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/company_intel"

# Redmine Integration
REDMINE_URL="https://redmine.yourcompany.com"
REDMINE_API_KEY="your-redmine-api-key-here"
REDMINE_SYNC_INTERVAL_MINUTES=15

# Google Chat Integration (Admin Dual-Dispatch Mirroring)
# 100% of System Notification Bar events will mirror to this webhook:
GOOGLE_CHAT_ADMIN_WEBHOOK_URL="https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=KEY&token=TOKEN"

# OpenRouter AI Integration (Grounded Assistant)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
OPENROUTER_DEFAULT_MODEL="anthropic/claude-3.5-sonnet"
OPENROUTER_FALLBACK_MODEL="google/gemini-2.0-flash-001"

